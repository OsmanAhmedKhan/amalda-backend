# AMALDA Configuration
DEFAULT_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage Paths (Local Fallbacks)
UPLOAD_DIR=./data/uploads
CHROMA_PERSIST_DIR=./data/chroma_db

# LLM Providers (Free Tiers)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_secondary_groq_key_here
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# InsForge Cloud Database
INSFORGE_DB_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"

# InsForge Cloud Storage (S3)
INSFORGE_S3_ENDPOINT=https://your-endpoint.insforge.app/storage/v1/s3
INSFORGE_S3_ACCESS_KEY=your_s3_access_key
INSFORGE_S3_SECRET_KEY=your_s3_secret_key
INSFORGE_S3_BUCKET=amalda-legal-docs